{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "principal",
  "model": "github-copilot/gpt-5.6-luna",
  "agent": {
    "build": { "disable": true },
    "plan": { "model": "github-copilot/gpt-5.6-luna" }
  },
  "timeline": {
    "enabled": true,
    "timestamps": "iso"
  },
  "permission": {
    "external_directory": {
      "~/.agents/**": "allow",
      "/tmp/**": "allow",
      "/var/folders/**": "allow",
      "~/src/**": "ask"
    }
  }
}
